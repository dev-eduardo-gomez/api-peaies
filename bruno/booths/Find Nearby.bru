meta {
  name: Find Nearby
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/booths/nearby?lat={{lat}}&lng={{lng}}&radiusKm={{radius}}
  body: none
  auth: bearer
}

params:query {
  lat: {{lat}}
  lng: {{lng}}
  radiusKm: {{radius}}
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  lat: 18.612621
  lng: -91.860885
  radius: 100
}

settings {
  encodeUrl: true
  timeout: 0
}
