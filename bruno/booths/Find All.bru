meta {
  name: Find All
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/booths?page={{page}}&limit={{limit}}
  body: none
  auth: bearer
}

params:query {
  page: {{page}}
  limit: {{limit}}
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  page: 5
  limit: 3
}

settings {
  encodeUrl: true
  timeout: 0
}
