meta {
  name: Update Vehicle
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/vehicles/{{vehicleId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "cargoWeightKg": 12.0,
    "maxCargoCapacityKg": 14.0
  }
}

vars:pre-request {
  vehicleId: {{vehicleId}}
}

settings {
  encodeUrl: true
  timeout: 0
}
