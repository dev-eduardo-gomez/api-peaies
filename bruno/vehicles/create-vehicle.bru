meta {
  name: Create Vehicle
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/vehicles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "alias": "Mi Versa",
