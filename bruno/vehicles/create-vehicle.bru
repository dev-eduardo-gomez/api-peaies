meta {
  name: Create Vehicle
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/vehicles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "alias": "Tráiler Norte",
    "plate": "TRL-001",
    "vehicleTypeCode": "5AxlesTruck",
    "fuelTypeCode": "DIESEL",
    "cargoTypeCode": "DRY",
    "engine": { "displacementCc": 12900, "cylinders": 6, "horsepower": 510 },
    "year": 2020,
    "brand": "Kenworth",
    "model": "T680",
    "dimensions": {
      "weightKg": 36000,
      "heightM": 4.10,
      "lengthM": 22.0,
      "widthM": 2.59,
      "axles": 5
    },
    "efficiency": { "cityKmpl": 3.0, "hwyKmpl": 4.5, "tankCapacityL": 600 },
    "tags": []
  }
}

script:post-response {
  var data = res.getBody();
  if (res.getStatus() === 201 && data.id) {
    bru.setEnvVar("vehicleId", data.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
